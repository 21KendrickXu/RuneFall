#script for colorblind filter
-- Get the Lighting service
local Lighting = game:GetService("Lighting")

-- Reference to the filter toggle button
local FilterButton = script.Parent

-- Define available filters (effect name in Lighting, and display name)
local filters = {
	{effectName = nil, name = "No filters"}, -- No filter applied
	{effectName = "ColorCorrection-Red", name = "Red"}, -- Red filter
	{effectName = "ColorCorrection-Blue", name = "Blue"}, -- Blue filter
	{effectName = "ColorCorrection-Green", name = "Green"}, -- Green filter
}

-- Initialize the current filter index if not already set
if Lighting:GetAttribute("CurrentFilterIndex") == nil then
	Lighting:SetAttribute("CurrentFilterIndex", 1)
end

-- Function to switch to the next filter in the list
local function switchFilter()
	-- Get the current index and move to the next
	local currentIndex = Lighting:GetAttribute("CurrentFilterIndex")
	currentIndex = currentIndex + 1
	if currentIndex > #filters then
		currentIndex = 1 -- Loop back to the first filter
	end
	Lighting:SetAttribute("CurrentFilterIndex", currentIndex)

	-- Disable all filters in the list
	for _, filter in ipairs(filters) do
		if filter.effectName then
			local effect = Lighting:FindFirstChild(filter.effectName)
			if effect then
				effect.Enabled = false
			end
		end
	end

	-- Enable the selected filter, if it has a valid effect name
	local selected = filters[currentIndex]
	if selected.effectName then
		local effect = Lighting:FindFirstChild(selected.effectName)
		if effect then
			effect.Enabled = true
		end
	end

	-- Update the button text to show the current filter
	FilterButton.Text = "Filter: " .. selected.name
end

-- Set the initial button text based on the current filter
local initialIndex = Lighting:GetAttribute("CurrentFilterIndex")
FilterButton.Text = "Filter: " .. filters[initialIndex].name

-- Connect button click to switch filter function
FilterButton.MouseButton1Click:Connect(switchFilter)

#script for tutorial page
local steps = {
	"Welcome to the game!",
	"This game is called Shibuya Battleground",
	"Use WASD to move around.",
	"Use F to stop the time nearby.",
	"Use R to pull your rivals and punch them.",
	"Use E to release a blue ball to attack your rivals.",
	"Check your kills and deaths on the leaderboard.",
	"Good luck, have fun!"
}

local currentStep = 1

local instructionLabel = script.Parent:WaitForChild("TextLabel")
local NextPageButton = script.Parent:WaitForChild("NextPageButton")
local LastPageButton = script.Parent:WaitForChild("LastPageButton")

-- Update the displayed instruction and button states
local function updateStep()
	instructionLabel.Text = steps[currentStep]
	LastPageButton.Visible = currentStep > 1
	NextPageButton.Text = currentStep == #steps and "Finish" or "Next Page"
end

updateStep()

-- Handle clicking the Next button
NextPageButton.MouseButton1Click:Connect(function()
	if currentStep < #steps then
		currentStep += 1
		updateStep()
	else
		-- Hide tutorial on finish and reset
		script.Parent.Visible = false
		currentStep = 1
		updateStep()
		-- Mark tutorial completed for player
		local player = game.Players.LocalPlayer
		if player:FindFirstChild("HasCompletedTutorial") then
			player.HasCompletedTutorial.Value = true
		end
	end
end)

-- Handle clicking the Last button
LastPageButton.MouseButton1Click:Connect(function()
	if currentStep > 1 then
		currentStep -= 1
		updateStep()
	end
end)

