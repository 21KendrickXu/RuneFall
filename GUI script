-- Predefined volume levels to cycle through
local volumeLevels = {0, 0.1, 0.2, 0.5, 0.75, 0.8, 0.9, 1}
local currentVolumeIndex = #volumeLevels  -- Start at max volume

-- Update button text to show current volume percentage
local function updateButtonText()
	button.Text = "Volume: " .. math.floor(bgm.Volume * 100) .. "%"
end

